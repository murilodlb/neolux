# Auto-generated by scripts/generate_extras.lua — do not edit manually
# Neolux colorscheme for tmux
# Usage: add 'source-file /path/to/neolux/extras/tmux/neolux.tmux' to ~/.tmux.conf

set -g mode-style "fg=#000000,bg=#f98800,bold"
set -g message-style "fg=#f98800,bg=#0c0c0c,bold"
set -g message-command-style "fg=#55efef,bg=#0c0c0c,bold"

set -g pane-border-style "fg=#3c3c3a"
set -g pane-active-border-style "fg=#f98800"

set -g status "on"
set -g status-justify "left"
set -g status-style "fg=#ffffff,bg=#0c0c0c"
set -g status-left-length "100"
set -g status-right-length "100"

set -g status-left "#[fg=#000000,bg=#55efef,bold]#{?client_prefix,#[bg=#f98800],} #S #[default] "
set -g status-right "#[fg=#ffffff,bg=#3c3c3a] %Y-%m-%d %H:%M #[fg=#000000,bg=#55efef,bold] #h "

set -g window-status-separator ""
set -g window-status-style "fg=#57595b,bg=#0c0c0c"
set -g window-status-current-style "fg=#000000,bg=#f98800,bold"
set -g window-status-activity-style "fg=#ffcc00,bg=#0c0c0c,bold"
set -g window-status-bell-style "fg=#000000,bg=#f84285,bold"
set -g window-status-format " #I:#W "
set -g window-status-current-format " #I:#W "

set -g clock-mode-colour "#55efef"
